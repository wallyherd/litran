# Exemplo de arquivo .env para Deploy no Supabase
PORT=4000
JWT_SECRET="sua_chave_secreta_aqui"

# Supabase PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:[SUA_SENHA_SUPABASE]@db.[SEU_PROJETO_SUPABASE].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[SUA_SENHA_SUPABASE]@db.[SEU_PROJETO_SUPABASE].supabase.co:5432/postgres"
